<script>
// Async pagination for Contao news lists using dvc ajax_reload_element.
(function () {
  function onClick(event) {
    var link = event.target.closest('.pagination a, .newscategories a');

    if (!link) {
      return;
    }

    var moduleElement = link.closest('.mod_newslist');

    if (!moduleElement) {
      return;
    }

    var reloadElement = moduleElement.getAttribute('data-ajax-reload-element');

    if (!reloadElement || moduleElement.getAttribute('data-ajax-reload-loading') === '1') {
      return;
    }

    event.preventDefault();
    event.stopImmediatePropagation();

    var url = new URL(link.getAttribute('href'), window.location.href);
    var requestToken = moduleElement.getAttribute('data-ajax-reload-token');
    var contentElement = moduleElement.querySelector('.blog-list, .news-list, [data-request-token]');
    var formData = new FormData();

    if (!requestToken && contentElement) {
      requestToken = contentElement.getAttribute('data-request-token');
    }

    formData.append('ajax_reload_element', reloadElement);

    if (requestToken) {
      formData.append('REQUEST_TOKEN', requestToken);
    }

    moduleElement.setAttribute('data-ajax-reload-loading', '1');

    fetch(url.pathname + (url.search || ''), {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'X-Requested-With': 'XMLHttpRequest',
        'Accept': 'application/json'
      },
      body: formData
    })
      .then(function (response) {
        return response.json();
      })
      .then(function (response) {
        if (!response || response.status !== 'ok' || !response.html) {
          location.href = link.href;

          return;
        }

        var container = document.createElement('div');

        container.innerHTML = response.html;

        var nextModuleElement = container.firstElementChild;

        if (!nextModuleElement) {
          location.href = link.href;

          return;
        }

        moduleElement.replaceWith(nextModuleElement);

        if (typeof lightbox !== 'undefined' && typeof lightbox.reload === 'function') {
          lightbox.reload();
        }

        try {
          nextModuleElement.scrollIntoView({behavior: 'smooth', block: 'start', inline: 'nearest'});
        } catch (error) {
          nextModuleElement.scrollIntoView();
        }
      })
      .catch(function () {
        location.href = link.href;
      })
      .finally(function () {
        moduleElement.removeAttribute('data-ajax-reload-loading');
      });
  }

  document.addEventListener('click', onClick, true);
})();
</script>
